# Build output
build/
.gradle/
run/
runs/
out/
*.jar

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
bin/

# Decompiled Refined Storage sources, kept locally for reference.
#
# Ignored because it is a build input, not source: a jar does not belong in git, and RS
# should be fetched from upstream rather than vendored here. (RS is MIT, so redistributing
# it would in fact be permitted -- that is not the reason.) Regenerate locally; see SETUP.md.
decompiled/

# libs/ holds Refined Storage's jar, taken from a Minecraft instance. Same reasoning:
# a jar is a build input, not source. A fresh clone has none of it -- SETUP.md says what to
# copy in.
libs/

# Dev-run leftovers, listed explicitly because these are the ones that would quietly turn
# a small repository into a huge one.
worlds/
saves/
logs/
*.hprof
*.log

# ...but the Gradle wrapper jar must be committed, or a fresh clone cannot build.
!gradle/wrapper/gradle-wrapper.jar

# Third-party textures unpacked from other mods' jars, as a working reference while
# drawing ours. Both sources are MIT so redistributing them would be permitted, but these
# are scratch copies, not assets of this mod -- the real ones live in src/main/resources
# and are covered by ATTRIBUTION.md.
texture-refs/
